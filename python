def show_workload_summary(df):
  if df is None or df.empty:
    print("No data available.")
    return
    summary = df.groupby("Faculty")["Hours"].sum().reset_index()
    print("\n--- Workload Summary ---")
    for _, row in summary.iterrows():
      faculty = row["Faculty"]
      total_hours = row["Hours"]
      if total_hours > MAX_LIMIT:
        print(
          f"{faculty}:{total_hours} hours - OVERLOADED by"
          f" {total_hours - MAX_LIMIT} hours"
        )
      else:
        print(
          f"{faculty} : {total_hours} hours ({MAX_LIMIT - total_hours} free)"
        )

